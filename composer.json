{
  "name": "joaopauloctga/drop-context",
  "description": "Install and manage AI agent skills provided by Drop Context",
  "type": "library",
  "license": "MIT",
  "homepage": "https://dropcontext.dev",
  "keywords": [
    "drupal",
    "ai",
    "agent",
    "skills",
    "cli"
  ],
  "support": {
    "issues": "https://github.com/joaopauloctga/drop-context/issues",
    "source": "https://github.com/joaopauloctga/drop-context"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    },
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "DropContext\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "authors": [
    {
      "name": "Joao Paulo Constantino",
      "email": "joaopauloctga@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-fileinfo": "*",
    "ext-zip": "*",
    "composer-runtime-api": "^2.2",
    "guzzlehttp/guzzle": "^7.0",
    "laravel/prompts": "^0.1.25 || ^0.2 || ^0.3",
    "mcp/sdk": "^0.7",
    "symfony/config": "^7.0",
    "symfony/console": "^7.0",
    "symfony/dependency-injection": "^7.0",
    "symfony/filesystem": "^7.0",
    "symfony/yaml": "^7.0"
  },
  "bin": [
    "bin/drop-context",
    "bin/drop-context-mcp"
  ]
}
